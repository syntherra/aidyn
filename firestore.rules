rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null }
    function isOwner(uid) { return isAuthed() && request.auth.uid == uid }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Onboarding documents: one doc per user (doc id = uid)
    match /onboarding/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.data.userId == request.auth.uid;
    }

    // Per-user onboarding sessions and messages
    match /onboarding_sessions/{sid} {
      allow read, write: if isAuthed() && request.resource.data.userId == request.auth.uid;

      match /messages/{mid} {
        allow create, read: if isAuthed() && get(/databases/$(database)/documents/onboarding_sessions/$(sid)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /user_activities/{doc} {
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /app_logs/{doc} {
      allow create: if isAuthed();
      allow read: if false; // restrict logs from general reads (use admin tools)
      allow update, delete: if false;
    }
  }
}
